# Neo4j used by the COI graph agent
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j
COI_QUERY_TIMEOUT=15

# Per-clause CR grounded analysis LLM (does not receive CL/COI/LE outputs)
LEXGUARD_LLM_API_STYLE=ollama
LEXGUARD_LLM_BASE_URL=http://localhost:11434
LEXGUARD_LLM_MODEL=qwen2.5:1.5b
# For an OpenAI-compatible server, set API_STYLE=openai_compatible and BASE_URL=http://host:port/v1
# Optional for servers that require authentication:
# LEXGUARD_LLM_API_KEY=

